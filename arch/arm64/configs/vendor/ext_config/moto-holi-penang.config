#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#
CONFIG_PENANG_DTB=y
CONFIG_FS_EPOLL_WAKEUP_DEBUG=y
CONFIG_ZRAM_WRITEBACK=y
# CONFIG_THERMAL_STATISTICS is not set
# CONFIG_REGULATOR_QPNP_LCDB is not set
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CAM_SENSOR_PROBE_RETRY=y
CONFIG_SND_SOC_AW87XXX=m
CONFIG_MSM_TZ_QSEE_LOG=y
CONFIG_AF_NOISE_ELIMINATION=y
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_UFSFEATURE is not set
# CONFIG_UFSHPB is not set
# CONFIG_UFSTW is not set
# CONFIG_SCSI_SKHPB is not set
CONFIG_MMAP_READAROUND_LIMIT=y

# Camera
CONFIG_CAMERA_CCI_INTF=m

# Charger
CONFIG_BQ2589X_CHARGER=m
CONFIG_RT_PD_MANAGER=m
CONFIG_SGM4154X_CHARGER=m
CONFIG_MMI_CHARGER=m
CONFIG_MMI_DISCRETE_CHARGER=m
CONFIG_MMI_DISCRETE_CHARGER_CLASS=m
CONFIG_TCPC_CLASS=m
CONFIG_TCPC_RT1711H=m
CONFIG_TCPC_SGM7220=m
CONFIG_TYPEC_ADAPTER_CLASS=m
CONFIG_CW2217B_FG_MMI=m
CONFIG_QPNP_ADAPTIVE_CHARGE=m

# Fingerprint
CONFIG_INPUT_CHIPONE_FPS_MMI=m
CONFIG_INPUT_CHIPONE_FPS_MMI_SUPPORT_POWER_GPIO=y
CONFIG_INPUT_MISC_FPC1020=m
CONFIG_INPUT_MISC_FPC1020_SAVE_TO_CLASS_DEVICE=y

# MMI
CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_INFO=m
CONFIG_MMI_RELAY=m
CONFIG_MMI_SYS_TEMP=m
CONFIG_MOTO_UTAGS=m
CONFIG_SENSORS_CLASS=m

# NFC
CONFIG_NFC_QTI_I2C=m

# SAR
CONFIG_SARSENSOR_SX937X=m

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_0FLASH_MMI_V2=m
# CONFIG_INPUT_FOCALTECH_0FLASH_MMI_ENABLE_DOUBLE_TAP is not set
CONFIG_INPUT_FOCALTECH_0FLASH_MMI_NOTIFY_TOUCH_STATE=y
# CONFIG_INPUT_FOCALTECH_PANEL_NOTIFICATIONS is not set
# CONFIG_INPUT_FOCALTECH_DEBUG_EN is not set
CONFIG_INPUT_FOCALTECH_PINCTRL_EN=y
CONFIG_FOCALTECH_LAST_TIME=y
CONFIG_INPUT_FOCALTECH_ESD_EN=y
CONFIG_INPUT_FOCALTECH_0FLASH_MMI_IC_NAME=y
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI_MMI=m
# CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_ENABLE_DOUBLE_TAP is not set
CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_NOTIFY_TOUCH_STATE=y
CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_LAST_TIME=y
CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_STOWED_MODE_EN=y
CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_CHIP_VER_1=y
# CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_WAKEUP_GESTURE_CTRL is not set
# CONFIG_BOARD_USES_DOUBLE_TAP_CTRL is not set

# Vibrator
CONFIG_LDO_VIBRATOR_MMI=m